    {
      "@id": "ActorDefinition-IMMZ.Persona.Child",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.Child",
      "dcterms:title": "Child",
      "dcterms:description": "A client who is 15 years of age or younger and who intends to receive immunization services from the targeted health worker personas.\n\n**Alternate names**: Infant, baby, client.\n\nA related generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.Child"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.Child.json"
      }
    },
    {
      "@id": "ActorDefinition-IMMZ.Persona.ClericalStaff",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.ClericalStaff",
      "dcterms:title": "Clerical staff",
      "schema:name": "ClericalStaff",
      "dcterms:description": "A clerical staff assists in scheduling appointments, answers phone calls, greets clients, keeps/documents medical records and handles medical billing.\n\n**Alternate names**: Registration clerk.\n\n**ISCO-08**: 3252 Clerk, information: health.\n\nA related generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.ClericalStaff"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.ClericalStaff.json"
      }
    },
    {
      "@id": "ActorDefinition-IMMZ.Persona.Client",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.Client",
      "dcterms:title": "Client",
      "dcterms:description": "In the context of this document, a client is a person who intends to receive immunization services from the targeted health worker personas. A client who is 15 years of age or younger is considered a child.\n\n**Alternate names**: Vaccinated person.\n\nA related generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.Client"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.Client.json"
      }
    },
    {
      "@id": "ActorDefinition-IMMZ.Persona.CommunityHealthWorker",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.CommunityHealthWorker",
      "dcterms:title": "Community health worker",
      "schema:name": "CommunityHealthWorker",
      "dcterms:description": "Community health workers provide health education, referral and follow-up, case management and basic preventive health care and home visiting services to specific communities. They provide support and assistance to clients by reminding them to get their vaccinations, responding to emergencies and reporting births.\n\n**Alternate names**: Community health volunteer, village health worker, volunteer assistant, volunteer health worker, treatment supporter, health promoter.\n\n**ISCO-08**: 3253 Worker, community: health.\n\nA targeted generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.CommunityHealthWorker"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.CommunityHealthWorker.json"
      }
    },
    {
      "@id": "ActorDefinition-IMMZ.Persona.EPIManager",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.EPIManager",
      "dcterms:title": "EPI Manager",
      "schema:name": "EPIManager",
      "dcterms:description": "Expanded Programme on Immunization (EPI) managers develop annual and multi-annual plans, immunization communication and mobilization, management of cold chain and vaccine logistics, monitoring, supervision and evaluation of immunization services, and coordination of EPI activities at the national and subnational levels.\n\n**Alternate names**: Programme manager.\n\n**ISCO-08**: 1342 Manager, health service.\n\nA targeted generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.EPIManager"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.EPIManager.json"
      }
    },
    {
      "@id": "ActorDefinition-IMMZ.Persona.HealthWorker",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.HealthWorker",
      "dcterms:title": "Health worker (HW)",
      "schema:name": "HealthWorker",
      "dcterms:description": "Health workers facilitate education sessions, administer immunizations, provide counselling when needed, record vaccinations administered, record stock movements and compile, generate, and submit reports.\n\n**Alternate names**: Nurse, registered nurse, practical nurse.\n\n**ISCO-08**: 3221 Nursing associate professional.\n\nA targeted generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.HealthWorker"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.HealthWorker.json"
      }
    },
    {
      "@id": "ActorDefinition-IMMZ.Persona.SystemAdministrator",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/IMMZ.Persona.SystemAdministrator",
      "dcterms:title": "System administrator",
      "schema:name": "SystemAdministrator",
      "dcterms:description": "A systems administrator, or a dedicated electronic immunization registry (EIR) staff, supervises the operation and storage of electronic health records and makes sure the server functions properly to allow clients and staff to communicate with each other, coordinate their actions and take care of essential tasks.\n\n**Alternate names**: IT manager, technical support, EIR staf.\n\n**ISCO-08**: 2522 Administrator, IT systems.\n\nA related generic persona of the WHO Digital Adaptation Kit for Immunizations.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/immunizations/ActorDefinition/IMMZ.Persona.SystemAdministrator"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-IMMZ.Persona.SystemAdministrator.json"
      }
