      <bpmn:outgoing>IMMZ.F.Flow8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="IMMZ.F.5" name="5. Plan to follow-up directly or during outreach">
      <bpmn:incoming>IMMZ.F.Flow5</bpmn:incoming>
      <bpmn:outgoing>IMMZ.F.Flow9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="IMMZ.F.8" name="8. Ensure client attends Immunization session or outreach session and is vaccinated">
      <bpmn:incoming>IMMZ.F.Flow7</bpmn:incoming>
      <bpmn:outgoing>IMMZ.F.Flow10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="IMMZ.F.10" name="10. Update record to document reason/lost to follow-up">
      <bpmn:incoming>IMMZ.F.Flow11</bpmn:incoming>
      <bpmn:outgoing>IMMZ.F.Flow12</bpmn:outgoing>
    </bpmn:task>
