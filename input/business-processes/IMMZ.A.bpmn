    <bpmn:task id="IMMZ.A.5" name="5. Notify NMFL team of change/ update">
      <bpmn:incoming>IMMZ.A.Flow11</bpmn:incoming>
      <bpmn:outgoing>IMMZ.A.Flow14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="IMMZ.A.6" name="6. Update/add new vaccination location">
