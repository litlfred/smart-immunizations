Instance: IMMZ.Persona.ClericalStaff
InstanceOf: ActorDefinition
Usage: #definition
* status = #draft
* experimental = true
* name = "ClericalStaff"
* title = "Clerical staff"
* type = #person
* description = """
A clerical staff assists in scheduling appointments, answers phone calls, greets clients, keeps/documents medical records and handles medical billing.

**Alternate names**: Registration clerk.

**ISCO-08**: 3252 Clerk, information: health.

A related generic persona of the WHO Digital Adaptation Kit for Immunizations.
"""
* documentation = "https://iris.who.int/handle/10665/380303"
